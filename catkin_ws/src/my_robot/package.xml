<?xml version="1.0"?>
<package format="2">
  <name>my_robot</name>
  <version>0.2.0</version>
  <description>Differential-drive robot with an RGB-D camera and Hokuyo lidar that maps its Gazebo building with RTAB-Map under keyboard control.</description>

  <maintainer email="henry.sebastien1982@gmail.com">Sebastien Henry</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>gazebo_plugins</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz</exec_depend>
  <exec_depend>rtabmap_slam</exec_depend>
  <exec_depend>rtabmap_viz</exec_depend>
  <exec_depend>rtabmap_demos</exec_depend>
  <exec_depend>teleop_twist_keyboard</exec_depend>

  <export>
    <!-- Lets Gazebo find model://landmarks (the poster textures) -->
    <gazebo_ros gazebo_model_path="${prefix}/models"/>
  </export>
</package>
