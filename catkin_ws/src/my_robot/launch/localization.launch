<?xml version="1.0" encoding="UTF-8"?>

<!-- Localization on a finished Database: RTAB-Map loads the Map and 3D Map from database_path and only
     works out where the robot is on them (Mem/IncrementalMemory=false), adding nothing new. Same inputs
     as mapping.launch; the Database is kept, not deleted, at startup. -->
<launch>
  <!-- Arguments for launch file with defaults provided -->
  <arg name="database_path"     default="rtabmap.db"/>
  <arg name="rgb_topic"         default="/camera/rgb/image_raw"/>
  <arg name="depth_topic"       default="/camera/depth/image_raw"/>
  <arg name="camera_info_topic" default="/camera/rgb/camera_info"/>
  <!-- rtabmapviz costs CPU the simulation needs; turn it on with rtabmapviz:=true -->
  <arg name="rtabmapviz"        default="false"/>

  <!-- Mapping Node. RTAB-Map 0.21+ (current Noetic apt) moved the nodes out of rtabmap_ros:
       rtabmap_ros/rtabmap is now rtabmap_slam/rtabmap, rtabmapviz is rtabmap_viz/rtabmap_viz. -->
  <group ns="rtabmap">
    <node name="rtabmap" pkg="rtabmap_slam" type="rtabmap" output="screen">

      <!-- Basic RTAB-Map Parameters: robot_footprint is this robot's base link (see my_robot.xacro) -->
      <param name="database_path"       type="string" value="$(arg database_path)"/>
      <param name="frame_id"            type="string" value="robot_footprint"/>
      <param name="odom_frame_id"       type="string" value="odom"/>
      <param name="subscribe_depth"     type="bool"   value="true"/>
      <param name="subscribe_scan"      type="bool"   value="true"/>

      <!-- RTAB-Map Inputs -->
      <remap from="scan"            to="/scan"/>
      <remap from="rgb/image"       to="$(arg rgb_topic)"/>
      <remap from="depth/image"     to="$(arg depth_topic)"/>
      <remap from="rgb/camera_info" to="$(arg camera_info_topic)"/>

      <!-- RTAB-Map Output -->
      <remap from="grid_map" to="/map"/>

      <!-- Rate (Hz) at which new nodes are added to map -->
      <param name="Rtabmap/DetectionRate" type="string" value="1"/>

      <!-- 2D SLAM -->
      <param name="Reg/Force3DoF" type="string" value="true"/>

      <!-- Map from the 270-degree lidar (sharp, gap-free walls); the camera builds the 3D Map -->
      <param name="Grid/FromDepth" type="string" value="false"/>

      <!-- Loop Closure Detection -->
      <!-- 0=SURF 1=SIFT 2=ORB 3=FAST/FREAK 4=FAST/BRIEF 5=GFTT/FREAK 6=GFTT/BRIEF 7=BRISK 8=GFTT/ORB 9=KAZE -->
      <!-- GFTT/ORB: always built in, unlike SURF which apt builds of rtabmap usually leave out -->
      <param name="Kp/DetectorStrategy" type="string" value="8"/>
      <param name="Vis/FeatureType"     type="string" value="8"/>

      <!-- Maximum visual words per image (bag-of-words) -->
      <param name="Kp/MaxFeatures" type="string" value="400"/>

      <!-- Loop Closure Constraint -->
      <!-- 0=Visual, 1=ICP (1 requires scan), 2=Visual then ICP refinement.
           If the Map shows doubled walls after a Loop Closure, try 2. -->
      <param name="Reg/Strategy" type="string" value="0"/>

      <!-- Minimum visual inliers to accept loop closure. If a run ends with fewer than 3 Loop Closures,
           lower this to 12 first. -->
      <param name="Vis/MinInliers" type="string" value="15"/>

      <!-- Localization mode: match against the Database, never extend it -->
      <param name="Mem/IncrementalMemory" type="string" value="false"/>
    </node>

    <!-- visualization with rtabmapviz -->
    <node if="$(arg rtabmapviz)" pkg="rtabmap_viz" type="rtabmap_viz" name="rtabmapviz"
          args="-d $(find rtabmap_demos)/launch/config/rgbd_gui.ini" output="screen">
      <param name="subscribe_depth" type="bool"   value="true"/>
      <param name="subscribe_scan"  type="bool"   value="true"/>
      <param name="frame_id"        type="string" value="robot_footprint"/>

      <remap from="rgb/image"       to="$(arg rgb_topic)"/>
      <remap from="depth/image"     to="$(arg depth_topic)"/>
      <remap from="rgb/camera_info" to="$(arg camera_info_topic)"/>
      <remap from="scan"            to="/scan"/>
    </node>
  </group>
</launch>
