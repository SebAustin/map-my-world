Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Tool Properties
    Name: Tool Properties
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: false
      Reference Frame: <Fixed Frame>
    - Class: rviz/Map
      Name: Map
      Enabled: true
      Topic: /map
      Color Scheme: map
      Alpha: 0.7
    - Class: rviz/PointCloud2
      Name: 3D Map
      Enabled: true
      Topic: /rtabmap/cloud_map
      Style: Points
      Size (Pixels): 3
      Color Transformer: RGB8
      Decay Time: 0
    - Class: rviz/Path
      Name: Robot Path
      Enabled: true
      Topic: /rtabmap/mapPath
      Color: 25; 255; 0
    - Class: rviz/RobotModel
      Name: RobotModel
      Enabled: true
      Robot Description: robot_description
    - Class: rviz/LaserScan
      Name: LaserScan
      Enabled: true
      Topic: /scan
      Size (m): 0.05
      Style: Flat Squares
      Color Transformer: FlatColor
      Color: 255; 0; 0
    - Class: rviz/Image
      Name: Camera
      Enabled: true
      Image Topic: /camera/rgb/image_raw
      Transport Hint: raw
  Global Options:
    Fixed Frame: map
    Background Color: 48; 48; 48
    Frame Rate: 30
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Measure
  Views:
    Current:
      Class: rviz/Orbit
      Name: Current View
      Distance: 12
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.9
      Yaw: 4.7
